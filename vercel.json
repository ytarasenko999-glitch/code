{
  "functions": {
    "api/tarot.js": {
      "maxDuration": 300
    },
    "api/blog.js": {
      "maxDuration": 15
    },
    "api/email.js": {
      "maxDuration": 20
    },
    "api/cron-emails.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/en/blog",
      "destination": "/api/blog?lang=en"
    },
    {
      "source": "/en/blog/:slug",
      "destination": "/api/blog?slug=:slug&lang=en"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/blog?sitemap=1"
    }
  ],
  "headers": [
    {
      "source": "/studio/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/studio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/blog-setup.sql",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://supabase.com"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/blog-en.sql",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://supabase.com"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-emails",
      "schedule": "0 7 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "code-matrix-test.vercel.app"
        }
      ],
      "destination": "https://code-matrix.space/:path",
      "permanent": true
    }
  ]
}